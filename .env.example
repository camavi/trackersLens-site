APP_NAME="Trackers Lens"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Production reference:
# APP_URL=https://trackerslens.com
# FRONTEND_URL=https://trackerslens.com
# CORS_ALLOWED_ORIGINS=https://trackerslens.com,https://www.trackerslens.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8000,localhost:8000
# Production reference:
# SESSION_DOMAIN=.trackerslens.com
# SANCTUM_STATEFUL_DOMAINS=trackerslens.com,www.trackerslens.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@trackerslens.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_INTERNAL_TO="hello@trackerslens.com"

# OVH MX Plan production reference:
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=smtp.mail.ovh.net
# MAIL_PORT=465
# MAIL_USERNAME=hello@trackerslens.com
# MAIL_PASSWORD=...
# MAIL_FROM_ADDRESS=hello@trackerslens.com
# MAIL_FROM_NAME="${APP_NAME}"
# MAIL_INTERNAL_TO=hello@trackerslens.com

# OVH shared hosting sendmail fallback:
# MAIL_MAILER=sendmail
# MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -t -i"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
